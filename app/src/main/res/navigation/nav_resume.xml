<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/nav_resume"
    app:startDestination="@id/resumeUploadFragment">

    <fragment
        android:id="@+id/resumeUploadFragment"
        android:name="com.example.aiinterviewcoach.ui.resume.ResumeUploadFragment"
        android:label="Resume Upload"
        tools:layout="@layout/fragment_resume_upload">

        <action
            android:id="@+id/action_resumeUploadFragment_to_resumeAnalysisFragment"
            app:destination="@id/resumeAnalysisFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/resumeAnalysisFragment"
        android:name="com.example.aiinterviewcoach.ui.resume.ResumeAnalysisFragment"
        android:label="Resume Analysis"
        tools:layout="@layout/fragment_resume_analysis" />

</navigation>
